# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
NODE_ENV=production
PORT=5000
# Public URL of the frontend (used for CORS). Comma-separate several origins.
CLIENT_ORIGIN=https://aibyte.world,https://www.aibyte.world
# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Database (MongoDB Atlas) ---
# Paste your Atlas connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://dineshgola025_db_user:QuF4tgocExAMnmA3@cluster0.ovfogov.mongodb.net/
# Database name inside the cluster. Tests use "<DB_NAME>_test" automatically.
DB_NAME=blogsite

# --- Authentication ---
# Long random string. setup.bat generates one for you if this is empty.
JWT_SECRET=eb3e8be9b6a3d15ae3967a3e38e7ea3c5ecef6dd0ba39ec5a996a0f6e9bcb0db5562befe62d63950e7d9f694813a1db3
# Token lifetime (jsonwebtoken format: 15m, 12h, 7d ...)
JWT_EXPIRES_IN=12h

# --- First administrator (used only by "npm run seed:admin") ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=dineshgola025@gmail.com
# Minimum 10 characters. Change it after first login.
ADMIN_PASSWORD=Dinesh@123

# --- Uploads ---
# Maximum upload size in megabytes
UPLOAD_MAX_MB=5
SECRETS_KEY=51157b41a7b95f16f6dd65f9b7c97bf6f58863aaaeda7e7558f5ad890f7890746455e1195b61bd9876cc6686ea24b0df
