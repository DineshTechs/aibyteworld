# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=5000
# Public URL of the frontend (used for CORS). Comma-separate several origins.
CLIENT_ORIGIN=http://localhost:5173
# Log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# --- Database (MongoDB Atlas) ---
# Paste your Atlas connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name inside the cluster. Tests use "<DB_NAME>_test" automatically.
DB_NAME=blogsite

# --- Authentication ---
# Long random string. setup.bat generates one for you if this is empty.
JWT_SECRET=
# Token lifetime (jsonwebtoken format: 15m, 12h, 7d ...)
JWT_EXPIRES_IN=12h

# --- First administrator (used only by "npm run seed:admin") ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=
# Minimum 10 characters. Change it after first login.
ADMIN_PASSWORD=

# --- AI (Phase 2) ---
# Encrypts API keys saved in the dashboard. setup.bat generates it. If you change
# it, keys saved earlier can no longer be read and must be entered again.
SECRETS_KEY=
# Optional fallback keys. The dashboard (AI Providers) is the preferred place
# for keys; these are used only when no key is saved there.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NOUS_API_KEY=
# Free options: Tavily (web search), Groq, Cerebras, Mistral, OpenRouter (writing)
TAVILY_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Ollama (free, local). Default http://127.0.0.1:11434
OLLAMA_BASE_URL=

# Free photo libraries for post images (optional; keys can be added in AI Providers instead).
# Images are never generated by AI.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Uploads ---
# Maximum upload size in megabytes
UPLOAD_MAX_MB=5
